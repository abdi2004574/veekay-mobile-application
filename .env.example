# Copy to .env. Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at
# build time (Expo's built-in env support) — never put secrets here.

EXPO_PUBLIC_API_BASE_URL=

# Firebase configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Social OAuth client IDs (verified server-side, no client secret in mobile)
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
EXPO_PUBLIC_APPLE_OAUTH_CLIENT_ID=

# Stripe publishable key for mobile payment flows
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# RevenueCat (not used per Veakay architecture — Stripe Billing handles agency subscriptions)
# EXPO_PUBLIC_REVENUECAT_API_KEY=

# Expo EAS / account credentials (managed via eas login CLI, not stored in env)
# EXPO_ACCOUNT_EMAIL=
# EXPO_ACCOUNT_PASSWORD=