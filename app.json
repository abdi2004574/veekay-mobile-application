{
    "expo":  {
                 "name":  "Veakay",
                 "slug":  "veakay",
                 "scheme":  "veakay",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "light",
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.veakay.app"
                         },
                 "android":  {
                                 "package":  "com.veakay.app",
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#E6F4FE",
                                                      "foregroundImage":  "./assets/android-icon-foreground.png",
                                                      "backgroundImage":  "./assets/android-icon-background.png",
                                                      "monochromeImage":  "./assets/android-icon-monochrome.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "googleServicesFile":  "./google-services.json"
                             },
                 "web":  {
                             "favicon":  "./assets/favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 "expo-status-bar",
                                 "expo-secure-store",
                                 "expo-web-browser",
                                 "expo-image",
                                 "expo-font",
                                 "expo-build-properties",
                                 "@react-native-firebase/app",
                                 [
                                     "expo-image-picker",
                                     {
                                         "photosPermission":  "Veakay uses your photos so you can attach them to posts and stories.",
                                         "cameraPermission":  "Veakay uses your camera so you can take a photo for a post or story."
                                     }
                                 ]
                             ]
                 }
             }
