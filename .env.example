# Copy to .env. Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at
# build time (Expo's built-in env support) — never put secrets here.

EXPO_PUBLIC_API_BASE_URL=

# Firebase configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Social OAuth client IDs (verified server-side, no client secret in mobile)
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
EXPO_PUBLIC_APPLE_OAUTH_CLIENT_ID=

# Stripe publishable key for OTHER mobile payment flows (donations, payouts).
# Agency subscriptions are handled by RevenueCat native IAP, NOT Stripe.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# RevenueCat — native agency subscription IAP (Basic / Premium / Featured),
# RESOLVED 2026-09-12. These are the PUBLIC SDK keys for react-native-purchases;
# never commit actual production keys. Use RevenueCat sandbox API keys for
# local/dev builds and production API keys for release builds. Sandbox and
# production behavior is selected by the API key environment in RevenueCat.
# Agency subscriptions are purchased natively on iOS and Android via RevenueCat;
# the backend verifies the webhook envelope + X-RevenueCat-Webhook-Signature.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Expo EAS / account credentials (managed via eas login CLI, not stored in env)
# EXPO_ACCOUNT_EMAIL=
# EXPO_ACCOUNT_PASSWORD=
